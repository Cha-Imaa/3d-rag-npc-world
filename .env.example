# Copy this file to .env and fill in real values. Never commit .env.
# Secrets are read by the backend only and must never reach browser code.

# Needed for NPC replies. The village still runs without it.
OPENAI_API_KEY=

# Optional. Leave blank to use the defaults in backend/app/settings.py.
OPENAI_CHAT_MODEL=
OPENAI_REASONING_EFFORT=
