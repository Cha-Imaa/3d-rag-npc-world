# Copy this file to .env and fill in real values. Never commit .env.
# Secrets are read by the backend only and must never reach browser code.

# Needed for NPC replies. The village still runs without it.
OPENAI_API_KEY=

# Optional. Leave blank to use the defaults in backend/app/settings.py.
OPENAI_CHAT_MODEL=
OPENAI_REASONING_EFFORT=
# Changing the embedding model means rebuilding every search index.
OPENAI_EMBEDDING_MODEL=

# Optional. Set to true to get labelled fake replies and fake embeddings instead of calling
# OpenAI. No key or credit is needed. To try an error, send a code such as llm_out_of_credit as
# the message (the codes are listed in backend/app/llm.py).
USE_FAKE_LLM=
